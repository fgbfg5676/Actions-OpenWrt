# This is an empty file, please overwrite it after generating the .config file with the source code
# 基础架构配置
CONFIG_TARGET_ipq40xx=y
CONFIG_TARGET_ipq40xx_generic=y
CONFIG_TARGET_ipq40xx_generic_DEVICE_mobipromo_cm520-79f=y

# OpBoot 兼容选项
CONFIG_IMAGEOPT=y
CONFIG_TARGET_IMAGES_GZIP=y

# 常用功能（根据需求添加）
CONFIG_PACKAGE_luci=y  # Web 管理界面
CONFIG_PACKAGE_luci-app-opkg=y  # 软件包管理
CONFIG_PACKAGE_kmod-ath10k=y  # 无线驱动（IPQ40xx 必需）
